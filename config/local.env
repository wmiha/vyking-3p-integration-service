# Local development values for config/config.yaml: dummy credentials only,
# never used outside a laptop. Read by `make run`, `make tokens` (variables
# already set in the shell win) and the compose `app` service (env_file).
# Plain KEY=value lines: no quotes, no `export`.
APP_ENV=local
LOG_LEVEL=debug
LOG_FORMAT=text
# Nothing routes traffic to a laptop, so stop without draining.
DRAIN_DELAY=0s

PPROF_ENABLED=true
PPROF_USERNAME=pprof
PPROF_PASSWORD=pprof-dev-only

DB_HOST=127.0.0.1
DB_NAME=vyking
DB_USER=app
DB_PASSWORD=app-dev-only
DB_POOL_MAX_OPEN=10
DB_POOL_MAX_IDLE=5
DB_REPLICA_HOST=127.0.0.1
DB_REPLICA_USER=app
DB_REPLICA_PASSWORD=app-dev-only
DB_REPLICA_POOL_MAX_OPEN=10
DB_REPLICA_POOL_MAX_IDLE=5

AUTH_KEY_ID=local-1
AUTH_JWT_SECRET=local-dev-only-jwt-secret-0123456789

# The acmemock service (compose overrides the URL with http://acmemock:8081).
ACME_BASE_URL=http://localhost:8081
ACME_API_KEY_BRAND_1=acme-key-brand-1-dev-only
ACME_API_KEY_BRAND_2=acme-key-brand-2-dev-only
# ACME_API_KEY_BRAND_3 stays unset: shows an unconfigured brand.
